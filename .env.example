# ──────────────────────────────────────────────────────────────────────────────
# PGRS Peedika — environment template
# Copy to .env (root) and/or per-app .env.local files. Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev example: postgres://<user>@localhost:5432/pgrs_peedika
DATABASE_URL=postgres://user:password@localhost:5432/pgrs_peedika

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Canonical URL where the backend serves /api/auth (used for redirects, cookies)
BETTER_AUTH_URL=http://localhost:4000

# ── App URLs ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Seed (packages/db) ────────────────────────────────────────────────────────
# Owner account created by `pnpm db:seed`. If the password is left empty the
# seed generates a strong random one and prints it once.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys (test mode).
# When empty, the payment module runs in "mock" mode: order creation returns a
# locally signed pseudo-order so the COD/test flow works end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Storage (S3-compatible, e.g. Cloudflare R2) ──────────────────────────────
# When S3_* vars are empty the backend uses the local disk driver (serves
# uploads from /uploads on the API domain) — dev only.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the browser uses to fetch uploaded files (R2 custom domain
# or CDN). For the local driver this is ignored.
S3_PUBLIC_URL=

# ── Notifications ─────────────────────────────────────────────────────────────
# console (default, logs to stdout) | webhook (POSTs JSON to NOTIFY_WEBHOOK_URL)
NOTIFY_PROVIDER=console
# Must be an https URL on a public host when NOTIFY_PROVIDER=webhook
NOTIFY_WEBHOOK_URL=

# ── WhatsApp ordering ─────────────────────────────────────────────────────────
# Shop number is read from Settings (shop.profile.whatsapp) in the admin panel.
# Inbound bot (optional): set both when connecting a WhatsApp Business (Meta
# Cloud API) app so customers can also text orders to the shop number.
# App secret used to verify X-Hub-Signature-256 on /api/whatsapp/webhook.
WHATSAPP_APP_SECRET=
# Token Meta echoes during webhook subscription verification.
WHATSAPP_VERIFY_TOKEN=
# ── Next.js apps (apps/web, apps/admin) ───────────────────────────────────────
# API base URL used by the server + browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# E2E tests only: expose issued OTPs at /api/auth/test-otp (never in production)
ENABLE_TEST_OTP=
