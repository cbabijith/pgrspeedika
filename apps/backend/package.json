{
  "name": "@pgrs/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean --outDir dist --target node22",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@hono/zod-validator": "^0.7.0",
    "@pgrs/auth": "workspace:*",
    "@pgrs/contracts": "workspace:*",
    "@pgrs/db": "workspace:*",
    "@pgrs/events": "workspace:*",
    "hono": "^4.8.5",
    "pdfkit": "^0.17.1",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pgrs/config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
