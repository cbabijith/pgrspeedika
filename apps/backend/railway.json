{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @pgrs/backend build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @pgrs/backend start",
    "preDeployCommand": "pnpm --filter @pgrs/backend predeploy",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
